{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    /* Vite compiles this, so resolution is the bundler's and imports stay
       extensionless — the same override `libs/contracts` and `libs/stage` make. */
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "types": ["bun", "vite/client"],
    /* `baseUrl` is gone: TypeScript resolves `paths` relative to this file
       already, and TS 7 deprecates it. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /* `vite.config.ts` is checked here rather than through a composite project
     reference. The reference existed to give it Node semantics; the base config
     covers that, and a referenced project cannot inherit `noEmit`. */
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
