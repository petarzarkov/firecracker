# Bun loads .env and .env.local itself, so there is no loader and no dotenv.
# Everything here is validated once at boot by src/config/env.validation.ts.

# ---- Service -----------------------------------------------------------------
# Required: there is no default, so boot fails without it.
API_PORT=3001
API_PREFIX=api
APP_ENV=local
NODE_ENV=development
TZ=UTC

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=debug
LOG_MASK_FIELDS=accessToken,jwt,password,secret,key,phone
LOG_FILTER_EVENTS=/api/health/live,/api/health/ready,/favicon.ico
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ---- Health ------------------------------------------------------------------
HEALTH_MAX_MEMORY_MB=2048
# Disk fullness that makes /api/health/ready report the disk down. Non-critical.
HEALTH_MAX_DISK_USED=0.9
# How long readiness keeps failing after SIGTERM before the socket closes. 0 in
# development; docker-compose.prod.yml sets 6000.
HEALTH_DRAIN_DELAY_MS=0

# ---- HTTP --------------------------------------------------------------------
CORS_ORIGIN=*
TRUST_PROXY=false
DOCS_PATH=docs
DOCS_JSON_PATH=openapi.json

# ---- Database ----------------------------------------------------------------
# sqlite is the only supported value: the data layer is synchronous (bun:sqlite).
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/firecracker.db
# POSTGRES_URL=postgres://user:pass@localhost:5432/app

# ---- Authentication (Better Auth) ---------------------------------------------
# Absent falls back to a constant in src/config/dto/auth-vars.dto.ts, which is fine
# locally and refused outright when APP_ENV=prod. 32 characters minimum.
# BETTER_AUTH_SECRET=
# Where cookies are issued for. Defaults to http://localhost:$API_PORT.
# WEB_URL=http://localhost:3001
# Vite's dev origin. better-auth checks the `Origin` header, and the browser still
# sends Vite's port even though the request goes through its proxy - so this is
# required for sign-in to work in development, not optional.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_SESSION_EXPIRATION=86400
AUTH_SESSION_UPDATE_AGE=3600
# `redis` puts live sessions in better-auth's secondaryStorage. It is an explicit
# opt-in because it does not degrade: choosing it is choosing to have Redis up.
AUTH_SESSION_STORE=database
# The first administrator, created through better-auth's own sign-up at boot.
# Never created when APP_ENV=prod.
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin-password
# A provider is enabled only when both halves are present.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ---- Redis, cache, throttling, queues and the websocket relay ------------------
# Absent is fine everywhere: the cache reports itself degraded, the throttler stops
# counting, the queue answers 503 and websocket fan-out stays local to the process.
# REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=500
CACHE_TTL_SECONDS=30
THROTTLE_PREFIX=firecracker
THROTTLE_LIMIT=20
THROTTLE_WINDOW_SECONDS=60
# This process serves HTTP and consumes its own queues. No `separate` mode and no
# `src/worker.ts`: `notifications` and `media` are `background`, so bullmq forks
# `src/jobs.processor.ts` for them. `false` is for the test suites only.
QUEUE_CONSUME=true
# Namespaces every bullmq key. Two deployments on one Redis need two values, or each
# consumes the other's jobs.
QUEUE_PREFIX=firecracker
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
QUEUE_CONCURRENCY=3
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION=1000
QUEUE_JOB_TIMEOUT_MS=120000
WS_RELAY_CHANNEL=firecracker:ws

# ---- Object storage ------------------------------------------------------------
# local is Bun.file and Bun.write under a directory; s3 is Bun.S3Client. Anything
# omitted below falls through to Bun's own credential resolution.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,text/csv,application/pdf

# ---- Images (Bun.Image) --------------------------------------------------------
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2048
IMAGE_THUMBNAIL_WIDTH=256

# ---- Build metadata (set by CI) ----------------------------------------------
# SERVICE_COMMIT_SHA=
# SERVICE_COMMIT_MESSAGE=

# ── Lobby bots ──────────────────────────────────────────────────────────────
# Simulated players, so an empty lobby does not look broken. **Cosmetic only**:
# a bot never touches the database, a wallet or the client-seed pool - see
# GameBotsService for why that boundary is enforced by its constructor.
GAME_BOTS_ENABLED=false
GAME_BOTS_MIN_PER_ROUND=2
GAME_BOTS_MAX_PER_ROUND=7
# Chance a bot comments after a round. Needs an AI provider configured below.
GAME_BOTS_CHAT_CHANCE=0.35

# ── AI providers ────────────────────────────────────────────────────────────
# All optional. With none set the app boots and serves; the bots simply stay
# quiet. One key per provider - each service talks to that vendor's own API.
# AI_GEMINI_API_KEY=
# AI_GROQ_API_KEY=
# AI_OPENROUTER_API_KEY=
AI_TEMPERATURE=0.8
AI_TIMEOUT_MS=30000

# ── Slack ───────────────────────────────────────────────────────────────────
# Service notices. Both are needed - with either missing, SlackService is silent.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=
