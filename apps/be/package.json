{
  "name": "firecracker-be",
  "version": "0.1.0",
  "private": true,
  "description": "Firecracker crash game backend: dunx on Bun, SQLite via drizzle, BullMQ, Better Auth and a native WebSocket gateway.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "start:dist": "bun dist/main.js",
    "build": "bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix src scripts e2e",
    "lint:check": "oxlint src scripts e2e",
    "test": "bun test",
    "test:unit": "bun test .test.ts",
    "test:int": "bun test .spec.ts",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test --preload ./e2e/setup/preload.ts $(find ./e2e -name '*.e2e.ts')",
    "email": "email dev --dir ./src/notifications/email/templates --port 3035",
    "mig:gen": "bun --env-file=.env drizzle-kit generate",
    "mig:run": "bun --env-file=.env ./scripts/migrate.ts",
    "db:studio": "bun --env-file=.env drizzle-kit studio",
    "db:drop": "bun ./scripts/db-drop.ts",
    "seed": "bun --env-file=.env ./scripts/seed.ts",
    "gen:openapi": "bunx dunx-openapi ./src/openapi.config.ts",
    "gen:env:docs": "bun ./scripts/gen-env-docs.ts"
  },
  "dependencies": {
    "@arkv/rng": "^0.8.2",
    "@dunx/auth": "^2.5.0",
    "@dunx/core": "^2.5.0",
    "@dunx/http": "^2.5.0",
    "@dunx/infra": "^2.5.0",
    "@dunx/openapi": "^2.5.0",
    "@dunx/transform": "^2.5.0",
    "@firecracker/contracts": "workspace:*",
    "@google/genai": "^2.17.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "better-auth": "^1.6.25",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dunx/testing": "^2.5.0",
    "@react-email/ui": "6.9.2",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "react-email": "6.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
