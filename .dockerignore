# The build context is the workspace root, so this covers both apps.
#
# Note what is *not* excluded and must not be: `bunfig.toml` carries the
# `@dunx/transform` preload, which is a runtime dependency rather than a build-time
# one - without it the server boots and fails naming a provider it could not build.

# Dependencies - reinstalled in the image from the lockfile
node_modules
apps/*/node_modules

# Build output, produced inside the image
dist
apps/*/dist

# Local database and Docker volumes
.tmp
apps/be/data
data

# Git and environment
.git
.gitignore
.env*
!.env.example

# IDE and editor
.vscode
.idea
.cursor
.claude
*.swp
*.swo

# Testing
e2e
apps/be/e2e
*.spec.ts
*.test.ts
coverage

# Documentation
*.md

# Logs
logs
*.log

# OS files
.DS_Store
Thumbs.db

# Docker itself
Dockerfile*
docker-compose*.yml
.dockerignore
