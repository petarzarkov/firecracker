# Workspace-root environment. Read by docker-compose only.
#
# The application's own configuration lives in apps/be/.env - every variable the
# server validates is declared there, and `bun run gen:env:docs` documents them.
# This file exists because compose needs a handful of values before any container
# starts, and those are not the app's to own.

# ── The tunnel (docker-compose.prod.yml) ────────────────────────────────────
TUNNEL_TOKEN=

# ── Redis ───────────────────────────────────────────────────────────────────
# Published on the host by docker-compose.yml. The app reaches it through
# REDIS_URL in apps/be/.env, which must agree with this port.
REDIS_PORT=6380
# Leave empty for no password. The container reads it and so does its healthcheck.
REDIS_PASSWORD=

# ── The API container (docker-compose.prod.yml) ─────────────────────────────
# Host port the API is published on. The container always listens on 3001.
API_PORT=3001

# Stamped into /api/service/config so a running container can be traced back to a
# commit. Usually set by CI rather than by hand.
COMMIT_SHA=
COMMIT_MESSAGE=

# Postgres is gone. The database is a SQLite file on the app-data volume, opened
# by both the API and the worker - see apps/be/src/infra/db/database.module.ts for
# the pragmas that make one file with two writers safe.
