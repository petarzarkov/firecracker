{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* Consumed as source by both a Bun app and a Vite bundle — `exports` points
       at `src/`, so there is no build step and each consumer compiles what it
       imports. That is also why imports here stay extensionless-free of Node's
       rules and resolve the bundler's way. */
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
